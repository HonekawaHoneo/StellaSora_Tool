{
  "schema_version": 1,
  "checks": [
    {"id": "tests", "kind": "test", "argv": ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]},
    {"id": "syntax", "kind": "lint", "argv": ["python", "-m", "compileall", "-q", "src", "tests"]},
    {"id": "security", "kind": "security", "argv": ["python", ".harness/security.py", "check-index", "."]},
    {"id": "structure", "argv": ["python", ".harness/structure.py", "check"]}
  ],
  "verification_inputs": [".jscpd.json", "tach.toml", "requirements-quality.txt"],
  "snapshot_ignore": [],
  "structural_quality": {
    "mode": "observe",
    "source_roots": ["src", "tests"],
    "clone_roots": ["src"],
    "required_checks": ["structure"],
    "jscpd_config": ".jscpd.json",
    "tach_config": "tach.toml"
  },
  "skill_bindings": {"orchestrator": "poteto-mode", "requirements": "grill-me", "design": "ponytail", "review": "ponytail-review"}
}
